# Base de datos
DATABASE_URL=jdbc:postgresql://localhost:5432/agencia_db
DATABASE_USERNAME=postgres
# Genera una contraseña nueva y segura (no uses la que estaba en .env)
DATABASE_PASSWORD=change-me

# OpenAI API key (genera una nueva en https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Clave secreta del JWT: genera una con: openssl rand -base64 64
JWT_SECRET=change-me-base64-64-bytes

# Origenes CORS permitidos, separados por comas
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Ruta donde se guardan los archivos subidos (fuera del classpath)
FILE_STORAGE_PATH=./storage

# Tamaño máximo para imágenes subidas (5 MB por defecto)
FILE_STORAGE_MAX_IMAGE_SIZE_BYTES=5242880
